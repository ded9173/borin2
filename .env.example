# Copy to .env and set unique values. Never commit .env.
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-value-at-least-32-characters
# Optional: PostgreSQL. If omitted in development, local SQLite is used.
# DATABASE_URL=postgresql+psycopg://borin_user:password@localhost:5432/borin
SQLALCHEMY_ECHO=false
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
PORT=5000
